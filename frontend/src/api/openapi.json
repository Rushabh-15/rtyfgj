  "info": {
    "summary": "GB wind forecast at the day-ahead decision cutoff vs outturn, January 2026 (Elexon WINDFOR, FUELHH)",
    "title": "Wind at cutoff",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    },
    "/api/v1/accuracy": {
      "get": {
        "description": "Error statistics, breakdowns, persistence skill, buffer back-test and lag scan at one cutoff.",
        "operationId": "accuracy_api_v1_accuracy_get",
        "parameters": [
          {
            "description": "Decision cutoff, UK clock time on the day before delivery (03:00-16:00, 30-minute steps)",
            "in": "query",
            "name": "cutoff",
            "required": false,
            "schema": {
              "default": "09:00",
              "description": "Decision cutoff, UK clock time on the day before delivery (03:00-16:00, 30-minute steps)",
              "pattern": "^\\d{2}:\\d{2}$",
              "title": "Cutoff",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accuracy"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "Cutoff or coverage outside the allowed values"
          }
        },
        "summary": "Accuracy",
